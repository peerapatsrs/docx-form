{
  "name": "@peerapat.srs/docx-form",
  "version": "2.0.0",
  "description": "Local CLI + Web UI to fill Word (.docx) templates — build tags from a sample doc, Gemini source mapping, text/bool/image/list loops",
  "type": "module",
  "bin": {
    "docx-form": "dist/index.js"
  },
  "files": [
    "dist",
    "web",
    "examples",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "author": {
    "name": "Peerapat Surasing",
    "email": "peerapat.srs@gmail.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/peerapatsrs/docx-form.git"
  },
  "bugs": {
    "url": "https://github.com/peerapatsrs/docx-form/issues"
  },
  "homepage": "https://github.com/peerapatsrs/docx-form#readme",
  "keywords": [
    "cli",
    "docx",
    "word",
    "template",
    "form",
    "easy-template-x",
    "peerapat.srs"
  ],
  "license": "MIT",
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "tsc -p tsconfig.json && node ./scripts/copy-web.mjs",
    "start": "node dist/index.js",
    "test:tagger:api": "node ./scripts/tagger-list-smoke.mjs",
    "test:tagger:e2e": "node ./scripts/test-tagger-e2e.mjs",
    "test:tagger:play": "SLOW_MS=500 node ./scripts/tagger-play-demo.mjs",
    "test:tagger": "npm run test:tagger:api && npm run test:tagger:e2e",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@hono/node-server": "^1.14.1",
    "commander": "^13.1.0",
    "easy-template-x": "^8.0.0",
    "hono": "^4.7.5",
    "jszip": "^3.10.1",
    "open": "^10.1.0",
    "pdfjs-dist": "^5.7.284",
    "tesseract.js": "^6.0.1"
  },
  "devDependencies": {
    "@types/jszip": "^3.4.0",
    "@types/node": "^22.13.10",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2"
  }
}
